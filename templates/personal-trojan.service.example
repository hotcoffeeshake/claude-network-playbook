[Unit]
Description=Personal authenticated Trojan TLS proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=personal-trojan
Group=personal-trojan
ExecStartPre=/usr/bin/sing-box check -c /etc/personal-trojan/config.json
ExecStart=/usr/bin/sing-box run -c /etc/personal-trojan/config.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
